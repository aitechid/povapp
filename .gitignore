# Ignore everything in workspace root by default
/*

# Exclude these directories and files
!/aitech/
!/poverty-portal/
!/production_migration_plan.md
!/.gitignore

# Sub-directory ignores for poverty-portal
/poverty-portal/node_modules/
/poverty-portal/.next/
/poverty-portal/.env*
/poverty-portal/next-env.d.ts
/poverty-portal/out/
/poverty-portal/build/
/poverty-portal/*.tsbuildinfo
/poverty-portal/coverage/
/poverty-portal/npm-debug.log*
/poverty-portal/yarn-debug.log*
/poverty-portal/yarn-error.log*
/poverty-portal/.pnpm-debug.log*
/poverty-portal/.vercel/
